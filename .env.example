# Copy to .env and fill in. Never commit .env.

KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/broker/callback

# 32-byte url-safe key, or any long passphrase. The app derives a Fernet key from it.
APP_MASTER_KEY=replace-with-a-long-random-string

# Preferred. ODBC string for the database you created with backend/sql/001_hextrade.sql.
# Windows auth example (no password):
# SQLSERVER_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=HexTrade;Trusted_Connection=yes;
SQLSERVER_CONNECTION_STRING=

SQLSERVER_HOST=localhost\SQLEXPRESS
SQLSERVER_DATABASE=HexTrade
SQLSERVER_TRUSTED_CONNECTION=yes
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Leave empty to auto-detect ODBC Driver 18, then 17.
SQLSERVER_ODBC_DRIVER=

REDIS_URL=redis://localhost:6379/0
CORS_ORIGIN=http://localhost:5173
